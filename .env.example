# 求職資料庫（與 E:\Playwright 的 jobhunt 資料庫共用）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobhunt
DB_USER=postgres
DB_PASSWORD=

# 本地 LLM（llama.cpp server 的 OpenAI 相容端點）
LLM_SERVER_URL=http://localhost:8080/v1/chat/completions
LLM_MODEL_NAME=qwen2.5-3b-instruct

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# 高分職缺推播門檻
NOTIFY_SCORE_THRESHOLD=80
