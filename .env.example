# 求職資料庫（與另一個關聯專案共用同一個jobhunt資料庫）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobhunt
DB_USER=postgres
DB_PASSWORD=

# 本地 LLM（llama.cpp server 的 OpenAI 相容端點）
LLM_SERVER_URL=http://localhost:8080/v1/chat/completions
LLM_MODEL_NAME=qwen2.5-3b-instruct

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
# webhook驗證用，跟上面的Access Token不同，在同一個Messaging API channel設定頁可以找到
LINE_CHANNEL_SECRET=

# 高分職缺推播門檻
NOTIFY_SCORE_THRESHOLD=80

# Gemini API（GENERAL/GMAIL意圖走這個）
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash

# Gmail API OAuth（見README的設定步驟）
GMAIL_CREDENTIALS_PATH=Gmail/credentials.json
GMAIL_TOKEN_PATH=Gmail/token.json

# email排程摘要（email_digest.py）一次最多處理幾封未讀信
DIGEST_MAX_EMAILS=10
